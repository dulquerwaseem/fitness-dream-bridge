# --- F22 devices ---
DEVICE_1_IP=192.168.1.201
DEVICE_1_NAME=1st Floor
DEVICE_2_IP=192.168.1.202
DEVICE_2_NAME=2nd Floor
DEVICE_PORT=4370
# zkteco-js has no support for an authenticated (non-zero) comm key — both
# devices must have Comm Key = 0 / disabled on the device menu for this to
# connect. DEVICE_COMM_KEY is recorded here for reference only; the bridge
# doesn't read or send it.
DEVICE_COMM_KEY=000000
DEVICE_TIMEOUT_MS=10000
DEVICE_INPORT=4000

# --- Supabase ---
SUPABASE_URL=https://skziijrnbrvcoxgeqnfy.supabase.co
# service_role secret (Dashboard > Project Settings > API), NOT the
# publishable/anon key. This script reads full member PII and must bypass
# members' RLS policies; service_role does that without weakening RLS for
# your real app users. It's safe here only because it stays in this local
# .env on a trusted back-office PC and is never shipped to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bridge behaviour ---
POLL_INTERVAL_MINUTES=5
